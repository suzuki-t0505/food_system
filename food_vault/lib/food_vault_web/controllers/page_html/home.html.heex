<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="space-y-2">
    <h1 class="text-2xl font-semibold">食品在庫管理システム</h1>
    <p id="current-user">
      {@current_scope.user.name} さん({FoodVault.Accounts.User.role_label(@current_scope.user.role)})
    </p>
  </div>
</Layouts.app>
